# App
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
APP_ENV=development
ADMIN_TOKEN=change-me-admin

# Postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sixframe_verify

# Redis
REDIS_URL=redis://localhost:6379

# Evidence storage (local filesystem fallback when STORAGE_* unset)
STORAGE_ENDPOINT=
STORAGE_BUCKET=6frame-verify-evidence
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=us-east-1
EVIDENCE_DIR=./evidence

# Stripe (leave empty to gate payments — unpaid jobs are refused)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_WEBSITE_QUICK=
STRIPE_PRICE_WEBSITE_FULL=
STRIPE_PRICE_CREATIVE_PACK=
STRIPE_PRICE_CREATIVE_SEQUENCE=
STRIPE_PRICE_CREDIT_PACK=

# Report integrity
REPORT_SIGNING_PRIVATE_KEY=
API_ENCRYPTION_KEY=

# Optional
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
MODEL_PROVIDER_PRIMARY_KEY=
MODEL_PROVIDER_FALLBACK_KEY=
